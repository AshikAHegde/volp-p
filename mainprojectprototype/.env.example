# VOLP Reminder Prototype Environment Template (.env.example)

PORT=4000
NODE_ENV=development

# VOLP Portal API Endpoints
VOLP_LOGIN_URL=
VOLP_LEARNER_URL=

# MySQL Local Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=volp_db

# Telegram Bot Configuration (Replaces email notifications)
# Create a bot via @BotFather on Telegram to obtain your token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional fallback chat ID (users can also save their chat_id on the web dashboard):
TELEGRAM_CHAT_ID=your_optional_telegram_chat_id

# Automated Cron Schedule and timezone (0 20 * * * = Daily at 8:00 PM)
CRON_SCHEDULE="0 20 * * *"
CRON_TIMEZONE=Asia/Kolkata

# Integration Test Credentials (used ONLY by tests/integration.test.js)
# Fill these in locally — never commit real credentials
TEST_VOLP_EMAIL=your_volp_email@vit.ac.in
TEST_VOLP_PASSWORD=your_volp_password

# Master 256-bit Encryption Key for securely storing credentials for background cron jobs
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_encryption_key

# ── Hackathon Dashboard (Premium Feature) ─────────────────────────────────────
# Postgres credentials — must match the DB used by your n8n instance.
# n8n populates unstop_events and devpost_events tables automatically.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
# Enable SSL when connecting to hosted providers like Supabase (auto-enabled if host != localhost)
# POSTGRES_SSL=true

# Admin secret for the developer-only POST /api/auth/set-premium endpoint.
# Set is_premium=true/false for any user via:
#   curl -X POST http://localhost:4000/api/auth/set-premium \
#        -H "x-admin-secret: <ADMIN_SECRET>" \
#        -H "Content-Type: application/json" \
#        -d '{"email":"student@vit.ac.in","is_premium":true}'
ADMIN_SECRET=your_strong_random_admin_secret_here