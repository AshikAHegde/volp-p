# VOLP Reminder Prototype Environment Template (.env.example)

PORT=4000
NODE_ENV=development

# VOLP Portal API Endpoints
VOLP_LOGIN_URL=
VOLP_LEARNER_URL=

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=volp_db

# Production SMTP Email Credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="VOLP Reminder Bot <no-reply@yourdomain.com>"

# Automated Cron Schedule (0 20 * * * = Daily at 8:00 PM)
CRON_SCHEDULE="0 20 * * *"
