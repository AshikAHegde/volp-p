# ==============================================================================
# VOLP Reminder — Environment Template (.env.example)
# Copy this file to .env and fill in your values: cp .env.example .env
# NOTE: Never commit your actual .env file with production credentials to Git.
# ==============================================================================

# ── 1. Server Configuration ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── 2. VOLP Portal LMS Endpoints ─────────────────────────────────────────────
# Endpoints used for session verification and 6-archetype assignment discovery
VOLP_LOGIN_URL=
VOLP_LEARNER_URL=

# ── 3. MongoDB Database (Primary Application Store) ──────────────────────────
# Stores user sessions, encrypted credentials, courses, and discovered assignments
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=volp_db
MONGODB_USERNAME=

# ── 4. Telegram Bot Push Alerts & 1-Click Deep Linking ──────────────────────
# Create your bot via @BotFather on Telegram (send /newbot) to obtain your token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional fallback Chat ID for admin-level broadcasts (users bind their own via 1-click):
TELEGRAM_CHAT_ID=your_optional_telegram_chat_id

# ── 5. Automated Daily 8:00 PM Reminder Dispatch (Cron Engine) ───────────────
# Default: Runs every day at 8:00 PM IST (0 20 * * *)
CRON_SCHEDULE="0 20 * * *"
CRON_TIMEZONE=Asia/Kolkata

# ── 6. Master AES-256-GCM Encryption Key ─────────────────────────────────────
# 64-character hex key (32 bytes) used to encrypt passwords at rest for background relogin.
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_encryption_key

# ── 7. Hackathon & Event Intelligence Hub (PostgreSQL / n8n / Supabase) ──────
# Connects to the PostgreSQL instance populated by n8n crawlers (Unstop & Devpost).
# Note: If PostgreSQL is unreachable, the system automatically uses resilient built-in fallback.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
# Set to true for cloud-hosted providers like Supabase / Neon (auto-enabled if host != localhost)
# POSTGRES_SSL=true

# ── 8. Developer Admin Secret ────────────────────────────────────────────────
# Used to toggle student is_premium status via POST /api/auth/set-premium:
# curl -X POST http://localhost:4000/api/auth/set-premium \
#      -H "x-admin-secret: <ADMIN_SECRET>" \
#      -H "Content-Type: application/json" \
#      -d '{"email":"student@vit.ac.in","is_premium":true}'
ADMIN_SECRET=your_strong_random_admin_secret_here

# ── 9. Integration Test Credentials (Used ONLY by tests/integration.test.js) ─
# Optional: test credentials for end-to-end integration tests
TEST_VOLP_EMAIL=your_volp_email@vit.ac.in
TEST_VOLP_PASSWORD=your_volp_password
