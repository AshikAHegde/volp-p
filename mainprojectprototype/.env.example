# VOLP Reminder Prototype Environment Template (.env.example)

PORT=4000
NODE_ENV=development

# VOLP Portal API Endpoints
VOLP_LOGIN_URL=
VOLP_LEARNER_URL=

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=volp_db

# Development Email Credentials (used when NODE_ENV=development)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_SECURE=false
MAILTRAP_SMTP_USER=your_mailtrap_user
MAILTRAP_SMTP_PASS=your_mailtrap_pass
MAILTRAP_SMTP_FROM="VOLP Reminder Bot <reminder@volp-project.com>"

# Production SMTP Email Credentials (used when NODE_ENV=production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="VOLP Reminder Bot <no-reply@yourdomain.com>"

# Automated Cron Schedule (0 20 * * * = Daily at 8:00 PM)
CRON_SCHEDULE="0 20 * * *"
